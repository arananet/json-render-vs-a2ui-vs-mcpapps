digraph matrix {
graph [margin=0, pad=0.05];
node [shape=plaintext, fontname="Helvetica", fontsize=11];
matrix [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6">
<tr><td align="left">Capability (adapter classification)</td><td bgcolor="#f5f5f5">json-render</td><td bgcolor="#f5f5f5">A2UI</td><td bgcolor="#f5f5f5">MCP Apps</td></tr>
<tr><td align="left">Continue another agent's surface</td><td bgcolor="#fff2b3">caveat</td><td bgcolor="#d9f0d3">supported</td><td bgcolor="#e8e8e8">not expressible</td></tr>
<tr><td align="left">Attribute a write to an agent</td><td bgcolor="#e8e8e8">not expressible</td><td bgcolor="#e8e8e8">not expressible</td><td bgcolor="#cfe2f3">enforced</td></tr>
<tr><td align="left">Isolate agents from each other</td><td bgcolor="#e8e8e8">not expressible</td><td bgcolor="#fff2b3">caveat</td><td bgcolor="#cfe2f3">enforced</td></tr>
<tr><td align="left">Compose into one view</td><td bgcolor="#fff2b3">caveat</td><td bgcolor="#d9f0d3">supported</td><td bgcolor="#e8e8e8">not expressible</td></tr>
<tr><td align="left">Retain both summaries after a fixed-order collision</td><td bgcolor="#f4c7c3">write lost</td><td bgcolor="#f4c7c3">write lost</td><td bgcolor="#d9d2e9">separate instances</td></tr>
<tr><td align="left">Route an action to its agent</td><td bgcolor="#fde0c5">out-of-band</td><td bgcolor="#fde0c5">out-of-band</td><td bgcolor="#d9f0d3">supported</td></tr>
<tr><td align="left">Gate a privileged action</td><td bgcolor="#fff2b3">caveat</td><td bgcolor="#e8e8e8">not expressible</td><td bgcolor="#cfe2f3">enforced</td></tr>
</table>>];
}
