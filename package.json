{
  "name": "json-render-vs-a2ui-vs-mcpapps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three real UI-testing scenarios comparing json-render, A2UI and MCP Apps for multi-agent orchestration",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:browser": "vite build && playwright test --grep-invert @screenshot",
    "test:all": "npm test && npm run test:browser",
    "report": "tsx src/report/generate.ts",
    "report:check": "tsx src/report/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "screenshots": "vite build && playwright test --grep @screenshot"
  },
  "dependencies": {
    "@a2ui/lit": "^0.11.0",
    "@a2ui/web_core": "^0.11.0",
    "@json-render/core": "^0.21.0",
    "@json-render/react": "^0.21.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "lit": "^3.3.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
